{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "extensions/**/*.ts",
    "utils/**/*.ts",
    "sandboxes/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
}